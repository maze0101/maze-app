rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }

    // Хэрэглэгчийн профайл (нэр, танилцуулга)
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if mine(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }

    // Нийтлэл, сэтгэгдэл
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if mine(request.resource.data.uid)
        && request.resource.data.text.size() <= 2000
        && request.resource.data.get('img', '').size() < 900000;
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'cc'])
      );
      allow delete: if mine(resource.data.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if mine(request.resource.data.uid)
          && request.resource.data.text.size() <= 500;
        allow delete: if mine(resource.data.uid);
      }
    }

    // Story
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if mine(request.resource.data.uid)
        && request.resource.data.text.size() <= 200;
      allow delete: if mine(resource.data.uid);
    }

    // Найзын хүсэлт (id = илгээгч_хүлээн авагч)
    match /requests/{reqId} {
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if mine(request.resource.data.from)
        && reqId == request.resource.data.from + '_' + request.resource.data.to;
      allow update, delete: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Найзууд (id = хоёр uid цагаан толгойн дарааллаар _-ээр холбогдсон)
    match /friendships/{fid} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in fid.split('_')
        && request.resource.data.members.hasAll(fid.split('_'));
    }

    // Видео дуудлага (WebRTC signaling)
    match /calls/{callId} {
      allow read, update: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if mine(request.resource.data.from);
      allow delete: if false;

      match /{col}/{candId} {
        allow read, create: if signedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
      }
    }

    // Чат (id нь найзуудын id-тай адил)
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.auth.uid in chatId.split('_')
        && request.resource.data.members.hasAll(chatId.split('_'));

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if signedIn()
          && request.auth.uid in chatId.split('_')
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text.size() <= 2000;
      }
    }
  }
}
