rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Имэйл баталгаажаагүй (эсвэл хуурамч) акаунт өгөгдөлд хандаж чадахгүй. Google акаунт автоматаар баталгаажсан.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // Зөвхөн бүртгэлийн үед: өөрийн профайлыг баталгаажуулахаас өмнө үүсгэнэ
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function stamped() { return request.resource.data.createdAt == request.time; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // админ: admins/{uid} баримтыг зөвхөн Firebase console-оос гараар үүсгэнэ
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // хаагдсан (ban) хэрэглэгч шинэ агуулга үүсгэж чадахгүй
    function notBanned() { return !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    // хайлтын түлхүүр үгс (жижиг үсгээр, угтвар хэлбэрээр)
    function kwOk(d) { return !('kw' in d) || (d.kw is list && d.kw.size() <= 120); }
    // @mention: дурдсан хэрэглэгчдийн uid (мэдэгдлийн төвд харуулахад)
    function mnOk(d) { return !('mn' in d) || (d.mn is list && d.mn.size() <= 10); }
    // сэтгэгдлийн тоо: нэмэхэд +1, сэтгэгдэл устгахад -1
    function ccStep() { return changed().hasOnly(['cc']) && (request.resource.data.cc == resource.data.cc + 1 || (resource.data.cc > 0 && request.resource.data.cc == resource.data.cc - 1)); }

    match /admins/{aid} {
      allow get: if signedIn() && request.auth.uid == aid;
    }
    match /bans/{bid} {
      allow get: if signedIn() && (request.auth.uid == bid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && bid != request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'reason', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        && isStr(request.resource.data.reason, 60)
        && stamped();
      allow delete: if isAdmin();
    }

    // ---------- Хэрэглэгчийн профайл ----------
    function validUser(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && (!('nameLower' in d) || isStr(d.nameLower, 40))
        && (!('bio' in d) || isStr(d.bio, 140))
        && (!('photo' in d) || isStr(d.photo, 60000))
        && (!('cover' in d) || isStr(d.cover, 60000))
        && (!('dm' in d) || d.dm in ['all', 'friends'])
        && (!('lastSeen' in d) || d.lastSeen is number || d.lastSeen is timestamp)
        && d.keys().hasOnly(['name', 'nameLower', 'bio', 'photo', 'cover', 'dm', 'lastSeen', 'createdAt']);
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if own(uid) && validUser(request.resource.data);
      allow delete: if own(uid);

      // push мэдэгдлийн токен (зөвхөн өөрийнх, сервер функц уншина)
      match /fcm/{tid} {
        allow read, delete: if mine(uid);
        allow create, update: if mine(uid)
          && request.resource.data.keys().hasOnly(['t', 'ua'])
          && isStr(request.resource.data.get('ua', ''), 200);
      }

      // хадгалсан нийтлэл (k='p') / reel (k='r'): зөвхөн өөрөө харна
      match /saved/{sid} {
        allow read, delete: if mine(uid);
        allow create, update: if mine(uid)
          && request.resource.data.keys().hasOnly(['k', 't'])
          && request.resource.data.k in ['p', 'r']
          && request.resource.data.t == request.time;
      }
    }

    // ---------- Нийтлэл ----------
    function onlyMeInSet(newL, oldL) {
      return newL is list
        && newL.size() <= oldL.size() + 1
        && newL.toSet().difference(oldL.toSet()).hasOnly([request.auth.uid])
        && oldL.toSet().difference(newL.toSet()).hasOnly([request.auth.uid]);
    }
    function rxOk() {
      let n = request.resource.data.get('rx', {});
      let o = resource.data.get('rx', {});
      return n is map
        && n.diff(o).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in n) || isStr(n[request.auth.uid], 8));
    }
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if mine(request.resource.data.uid) && notBanned()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'img', 'imgs', 'createdAt', 'likes', 'cc', 'kw', 'mn'])
        && kwOk(request.resource.data) && mnOk(request.resource.data)
        && (!('imgs' in request.resource.data) || (request.resource.data.imgs is list && request.resource.data.imgs.size() >= 2 && request.resource.data.imgs.size() <= 4))
        && isStr(request.resource.data.name, 40)
        && isStr(request.resource.data.text, 2000)
        && (request.resource.data.text.size() > 0 || 'img' in request.resource.data || 'imgs' in request.resource.data)
        && (!('img' in request.resource.data) || isStr(request.resource.data.img, 900000))
        && request.resource.data.likes == []
        && request.resource.data.cc == 0
        && stamped();
      allow update: if signedIn() && (
        // өөрийн нийтлэлийг засах
        (resource.data.uid == request.auth.uid
          && changed().hasOnly(['text', 'edited', 'kw', 'mn'])
          && kwOk(request.resource.data) && mnOk(request.resource.data)
          && isStr(request.resource.data.text, 2000)
          && (request.resource.data.text.size() > 0 || 'img' in resource.data || 'imgs' in resource.data)) ||
        // лайк: зөвхөн өөрийн uid-г нэмэх/хасах
        (changed().hasOnly(['likes']) && onlyMeInSet(request.resource.data.likes, resource.data.likes)) ||
        // сэтгэгдлийн тоо ±1
        ccStep() ||
        // реакц: зөвхөн өөрийн түлхүүр
        (changed().hasOnly(['rx']) && rxOk())
      );
      allow delete: if mine(resource.data.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if mine(request.resource.data.uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'mn', 'createdAt']) && mnOk(request.resource.data)
          && isStr(request.resource.data.name, 40)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && stamped() && notBanned()
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow delete: if mine(resource.data.uid) || isAdmin()
          || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
      }
    }

    match /{path=**}/comments/{cid} {
      allow read: if signedIn();
    }

    // ---------- Story ----------
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if mine(request.resource.data.uid) && notBanned()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'g', 'img', 'views', 'createdAt'])
        && isStr(request.resource.data.name, 40)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && (request.resource.data.text.size() > 0 || 'img' in request.resource.data)
        && (!('img' in request.resource.data) || isStr(request.resource.data.img, 300000))
        && (!('views' in request.resource.data) || request.resource.data.views == [])
        && request.resource.data.g is int && request.resource.data.g >= 0 && request.resource.data.g < 10
        && stamped();
      // үзсэн: зөвхөн өөрийн uid-г нэмнэ
      allow update: if signedIn() && changed().hasOnly(['views'])
        && onlyMeInSet(request.resource.data.views, resource.data.get('views', []));
      allow delete: if mine(resource.data.uid) || isAdmin();
    }

    // ---------- Reels: видео нь c/{0..11} дэд баримтуудад bytes хэлбэрээр (тус бүр ≤ 950KB) ----------
    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if mine(request.resource.data.uid) && notBanned()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'cap', 'n', 'mime', 'dur', 'w', 'h', 'poster', 'likes', 'cc', 'kw', 'mn', 'createdAt'])
        && kwOk(request.resource.data) && mnOk(request.resource.data)
        && isStr(request.resource.data.name, 40)
        && isStr(request.resource.data.cap, 300)
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 12
        && isStr(request.resource.data.mime, 80)
        && request.resource.data.dur is number && request.resource.data.dur > 0 && request.resource.data.dur <= 61
        && request.resource.data.w is int && request.resource.data.h is int
        && (!('poster' in request.resource.data) || isStr(request.resource.data.poster, 60000))
        && request.resource.data.likes == []
        && request.resource.data.cc == 0
        && stamped()
        // бүх хэсэг нь өмнө нь байршсан байх ёстой
        && exists(/databases/$(database)/documents/reels/$(reelId)/c/$(string(request.resource.data.n - 1)));
      allow update: if signedIn() && (
        (changed().hasOnly(['likes']) && onlyMeInSet(request.resource.data.likes, resource.data.likes)) ||
        ccStep() ||
        // үзсэн тоо +1
        (changed().hasOnly(['vc']) && request.resource.data.vc == resource.data.get('vc', 0) + 1)
      );
      allow delete: if mine(resource.data.uid) || isAdmin();

      // видеоны хэсэг: reel нийтлэгдэхээс өмнө л нэмнэ, засахгүй
      match /c/{ci} {
        allow read: if signedIn();
        allow create: if mine(request.resource.data.u)
          && request.resource.data.keys().hasOnly(['u', 'd'])
          && ci.matches('^([0-9]|1[01])$')
          && request.resource.data.d is bytes
          && request.resource.data.d.size() <= 950000
          && !exists(/databases/$(database)/documents/reels/$(reelId));
        allow delete: if mine(resource.data.u) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if mine(request.resource.data.uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'mn', 'createdAt']) && mnOk(request.resource.data)
          && isStr(request.resource.data.name, 40)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && stamped() && notBanned()
          && exists(/databases/$(database)/documents/reels/$(reelId));
        allow delete: if mine(resource.data.uid) || isAdmin()
          || get(/databases/$(database)/documents/reels/$(reelId)).data.uid == request.auth.uid;
      }
    }

    // ---------- Блок (id = блоклогч_блоклогдсон) ----------
    match /blocks/{bid} {
      allow read: if signedIn() &&
        (resource.data.by == request.auth.uid || resource.data.target == request.auth.uid);
      allow create: if mine(request.resource.data.by)
        && request.resource.data.keys().hasOnly(['by', 'target', 'createdAt'])
        && request.resource.data.target is string
        && request.resource.data.by != request.resource.data.target
        && bid == request.resource.data.by + '_' + request.resource.data.target
        && stamped();
      allow delete: if mine(resource.data.by);
    }

    // ---------- Найзын хүсэлт (id = илгээгч_хүлээн авагч) ----------
    match /requests/{reqId} {
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if mine(request.resource.data.from) && notBanned()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'status', 'createdAt'])
        && request.resource.data.to is string
        && request.resource.data.from != request.resource.data.to
        && reqId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && isStr(request.resource.data.fromName, 40)
        && isStr(request.resource.data.toName, 40)
        && stamped()
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.resource.data.from));
      // зөвхөн хүлээн авагч зөвшөөрч болно
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && changed().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ---------- Найзууд: зөвхөн зөвшөөрөгдсөн хүсэлттэй үед ----------
    function acceptedReq(a, b) {
      return exists(/databases/$(database)/documents/requests/$(a + '_' + b))
        && getAfter(/databases/$(database)/documents/requests/$(a + '_' + b)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/requests/$(a + '_' + b)).data.to == request.auth.uid;
    }
    match /friendships/{fid} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && fid.split('_').size() == 2
        && request.auth.uid in fid.split('_')
        && request.resource.data.members == fid.split('_')
        && request.resource.data.keys().hasOnly(['members', 'names', 'createdAt'])
        && (acceptedReq(fid.split('_')[0], fid.split('_')[1]) || acceptedReq(fid.split('_')[1], fid.split('_')[0]));
    }

    // ---------- Чат: 1:1 блоклоогүй үед. Найз биш хүнд зөвхөн тэр "бүгд" гэж тохируулсан бол ----------
    function pairOk(chatId) {
      let p = chatId.split('_');
      return p.size() == 2 && p[0] < p[1] && request.auth.uid in p
        && !exists(/databases/$(database)/documents/blocks/$(p[0] + '_' + p[1]))
        && !exists(/databases/$(database)/documents/blocks/$(p[1] + '_' + p[0]))
        && (exists(/databases/$(database)/documents/friendships/$(chatId))
            || get(/databases/$(database)/documents/users/$(p[0] == request.auth.uid ? p[1] : p[0])).data.get('dm', 'all') != 'friends');
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.lastAt == request.time
        && isStr(request.resource.data.last, 200)
        && (
          (pairOk(chatId)
            && request.resource.data.members == chatId.split('_')
            && (!('by' in request.resource.data) || request.resource.data.by == request.auth.uid)
            && request.resource.data.keys().hasOnly(['members', 'names', 'last', 'lastAt', 'lastFrom', 'seen', 'by']))
          ||
          (chatId.matches('g[a-z0-9]+')
            && request.resource.data.get('group', false) == true
            && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 20
            && request.auth.uid in request.resource.data.members
            && isStr(request.resource.data.name, 40)
            && (!('photo' in request.resource.data) || isStr(request.resource.data.photo, 60000))
            && (!('owner' in request.resource.data) || request.resource.data.owner == request.auth.uid)
            && request.resource.data.keys().hasOnly(['group', 'name', 'photo', 'owner', 'members', 'last', 'lastAt', 'lastFrom', 'seen']))
        );
      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        // "Үзсэн": зөвхөн өөрийн түлхүүр
        (changed().hasOnly(['seen'])
          && request.resource.data.seen.diff(resource.data.get('seen', {})).affectedKeys().hasOnly([request.auth.uid])) ||
        // мессеж засах/устгахад сүүлийн мессежийн урьдчилсан харагдацыг шинэчлэх (зөвхөн илгээгч)
        (changed().hasOnly(['last']) && resource.data.lastFrom == request.auth.uid && isStr(request.resource.data.last, 200)) ||
        // бичиж байна: зөвхөн өөрийн түлхүүр
        (changed().hasOnly(['typing'])
          && request.resource.data.typing.diff(resource.data.get('typing', {})).affectedKeys().hasOnly([request.auth.uid])) ||
        // мессежийн хүсэлт зөвшөөрөх: зөвхөн эхлүүлсэн хүнээс бусад нь
        (changed().hasOnly(['ok']) && request.resource.data.ok == true && resource.data.get('by', '') != request.auth.uid) ||
        // бүлгийн эзэн гишүүн нэмэх/хасах
        (resource.data.get('group', false) == true && resource.data.get('owner', '') == request.auth.uid
          && changed().hasOnly(['members'])
          && request.resource.data.members.size() >= 1 && request.resource.data.members.size() <= 20
          && request.auth.uid in request.resource.data.members) ||
        // бүлгийн нэр/зураг солих: гишүүн бүр
        (resource.data.get('group', false) == true && changed().hasOnly(['name', 'photo'])
          && isStr(request.resource.data.name, 40) && request.resource.data.name.size() > 0
          && isStr(request.resource.data.get('photo', ''), 60000)) ||
        // бүлгээс гарах: зөвхөн өөрийгөө хасна
        (resource.data.get('group', false) == true && changed().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())) ||
        // шинэ мессежийн мэдээлэл
        (changed().hasOnly(['members', 'names', 'last', 'lastAt', 'lastFrom', 'ok'])
          && (!('ok' in changed()) || (request.resource.data.ok == true && resource.data.get('by', '') != request.auth.uid))
          && request.resource.data.members == resource.data.members
          && request.resource.data.lastFrom == request.auth.uid
          && request.resource.data.lastAt == request.time
          && isStr(request.resource.data.last, 200)
          && (resource.data.get('group', false) == true || pairOk(chatId)))
      );

      allow delete: if signedIn() && request.auth.uid in resource.data.members && resource.data.get('group', false) != true;

      match /messages/{msgId} {
        allow read: if signedIn() && (
          request.auth.uid in chatId.split('_') ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        allow create: if signedIn()
          && (pairOk(chatId) ||
              (getAfter(/databases/$(database)/documents/chats/$(chatId)).data.get('group', false) == true
               && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members))
          && request.resource.data.from == request.auth.uid && notBanned()
          && request.resource.data.keys().hasOnly(['from', 'fn', 'text', 'img', 'aud', 're', 'fw', 'sh', 'poll', 'createdAt'])
          // санал асуулга: асуулт + 2-6 сонголт
          && (!('poll' in request.resource.data) || (request.resource.data.poll is map && request.resource.data.poll.keys().hasOnly(['q', 'o'])
                && isStr(request.resource.data.poll.q, 200) && request.resource.data.poll.q.size() > 0
                && request.resource.data.poll.o is list && request.resource.data.poll.o.size() >= 2 && request.resource.data.poll.o.size() <= 6))
          // хуваалцсан нийтлэл (k='p') / reel (k='r')
          && (!('sh' in request.resource.data) || (request.resource.data.sh is map && request.resource.data.sh.keys().hasOnly(['k', 'id', 't'])
                && request.resource.data.sh.k in ['p', 'r'] && isStr(request.resource.data.sh.id, 128) && isStr(request.resource.data.sh.t, 120)))
          && (!('re' in request.resource.data) || (request.resource.data.re is map && request.resource.data.re.keys().hasOnly(['n', 't'])
                && isStr(request.resource.data.re.n, 40) && isStr(request.resource.data.re.t, 100)))
          && (!('fw' in request.resource.data) || request.resource.data.fw == true)
          && isStr(request.resource.data.text, 2000)
          && isStr(request.resource.data.fn, 40)
          && (request.resource.data.text.size() > 0 || 'img' in request.resource.data || 'aud' in request.resource.data || 'sh' in request.resource.data || 'poll' in request.resource.data)
          && (!('img' in request.resource.data) || isStr(request.resource.data.img, 900000))
          && (!('aud' in request.resource.data) || isStr(request.resource.data.aud, 900000))
          && stamped();
        allow update: if signedIn() && (
          // реакц: гишүүн бүр зөвхөн өөрийн түлхүүрийг
          ((request.auth.uid in chatId.split('_') ||
              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members)
            && changed().hasOnly(['rx'])
            && request.resource.data.get('rx', {}).diff(resource.data.get('rx', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.get('rx', {}))
                || isStr(request.resource.data.get('rx', {})[request.auth.uid], 8))) ||
          // санал өгөх: гишүүн бүр зөвхөн өөрийн түлхүүрийг (сонголтын индекс)
          ((request.auth.uid in chatId.split('_') ||
              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members)
            && 'poll' in resource.data
            && changed().hasOnly(['pv'])
            && request.resource.data.get('pv', {}).diff(resource.data.get('pv', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.get('pv', {}))
                || (request.resource.data.pv[request.auth.uid] is int && request.resource.data.pv[request.auth.uid] >= 0
                    && request.resource.data.pv[request.auth.uid] < resource.data.poll.o.size()))) ||
          // засах: зөвхөн илгээгч, текстийг
          (resource.data.from == request.auth.uid
            && !('deleted' in resource.data)
            && changed().hasOnly(['text', 'edited'])
            && isStr(request.resource.data.text, 2000) && request.resource.data.text.size() > 0
            && request.resource.data.edited == true) ||
          // устгах (бүгдэд): зөвхөн илгээгч, агуулгыг нь арилгана
          (resource.data.from == request.auth.uid
            && changed().hasOnly(['text', 'img', 'aud', 'sh', 'poll', 'deleted'])
            && request.resource.data.deleted == true
            && request.resource.data.text == ''
            && !('img' in request.resource.data) && !('aud' in request.resource.data) && !('sh' in request.resource.data) && !('poll' in request.resource.data))
        );
        allow delete: if mine(resource.data.from);
      }
    }

    // ---------- Гомдол (зөвхөн бичих) ----------
    // kind: user | post | reel | msg. snip = гомдол гаргагчийн харсан агуулгын хэсэг (админ хувийн чатыг уншихгүй)
    match /reports/{rid} {
      allow create: if mine(request.resource.data.by)
        && request.resource.data.keys().hasOnly(['by', 'target', 'reason', 'postId', 'kind', 'snip', 'cid', 'createdAt'])
        && isStr(request.resource.data.target, 128)
        && isStr(request.resource.data.reason, 60)
        && (!('postId' in request.resource.data) || isStr(request.resource.data.postId, 128))
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['user', 'post', 'reel', 'msg'])
        && (!('snip' in request.resource.data) || isStr(request.resource.data.snip, 200))
        && (!('cid' in request.resource.data) || isStr(request.resource.data.cid, 128))
        && stamped();
      allow read, delete: if isAdmin();
    }

    // ---------- Видео дуудлага ----------
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    match /calls/{callId} {
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if mine(request.resource.data.from)
        && request.resource.data.to is string
        && request.resource.data.to != request.resource.data.from
        && request.resource.data.status == 'ringing'
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'status', 'offer', 'audio', 'createdAt'])
        && (!('audio' in request.resource.data) || request.resource.data.audio is bool)
        && isStr(request.resource.data.fromName, 40)
        && isStr(request.resource.data.toName, 40)
        && stamped()
        // найз биш ч дуудаж болно (блоклоогүй л бол)
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.from + '_' + request.resource.data.to))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.resource.data.from));
      allow update: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        && changed().hasOnly(['status', 'answer'])
        && request.resource.data.status in ['active', 'declined', 'ended']
        // хариулт, зөвшөөрөл, татгалзахыг зөвхөн дуудлага хүлээн авагч хийнэ
        && (request.resource.data.status == 'ended' || resource.data.to == request.auth.uid)
        && (!('answer' in changed()) || resource.data.to == request.auth.uid);
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      match /{col}/{candId} {
        allow delete: if signedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['c'])
          && isStr(request.resource.data.c, 2000)
          && (
            (col == 'callerCandidates' && get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid) ||
            (col == 'calleeCandidates' && get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid));
      }
    }

    // бүлгийн дуудлага (mesh): members = тухайн бүлгийн гишүүд, live = одоо дуудлагад байгаа хүмүүс
    match /gcalls/{callId} {
      function gchat() { return get(/databases/$(database)/documents/chats/$(request.resource.data.cid)).data; }
      function gm() { return signedIn() && request.auth.uid in resource.data.members; }
      allow read: if gm();
      allow create: if mine(request.resource.data.from)
        && request.resource.data.keys().hasOnly(['cid', 'from', 'fromName', 'name', 'members', 'live', 'status', 'audio', 'createdAt'])
        && request.resource.data.cid is string
        && gchat().group == true
        && request.resource.data.members == gchat().members
        && request.auth.uid in request.resource.data.members
        && request.resource.data.live == []
        && request.resource.data.status == 'active'
        && (!('audio' in request.resource.data) || request.resource.data.audio is bool)
        && isStr(request.resource.data.fromName, 40)
        && isStr(request.resource.data.name, 40)
        && stamped();
      // зөвхөн өөрийгөө live-д нэмж/хасна, мөн дуудлагыг дуусгаж болно
      allow update: if gm()
        && changed().hasOnly(['live', 'status'])
        && request.resource.data.live is list
        && request.resource.data.live.toSet().difference(resource.data.live.toSet()).hasOnly([request.auth.uid])
        && resource.data.live.toSet().difference(request.resource.data.live.toSet()).hasOnly([request.auth.uid])
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'ended');
      allow delete: if mine(resource.data.from);

      match /sig/{sigId} {
        function gmem(u) { return u in get(/databases/$(database)/documents/gcalls/$(callId)).data.members; }
        allow read, delete: if signedIn() && (resource.data.t == request.auth.uid || resource.data.f == request.auth.uid);
        allow create: if mine(request.resource.data.f)
          && request.resource.data.keys().hasOnly(['f', 't', 's', 'k', 'd'])
          && request.resource.data.t is string
          && request.resource.data.k in ['o', 'a', 'c', 'v']
          && isStr(request.resource.data.s, 20)
          && isStr(request.resource.data.d, 30000)
          && gmem(request.auth.uid) && gmem(request.resource.data.t);
      }
    }

    // онлайн уулзалт: баримтын id = санамсаргүй код (abc-defg-hij). Кодыг мэдэх нэвтэрсэн хэн ч нэгдэнэ,
    // жагсаалтаар бусдын уулзалтыг харах боломжгүй (list зөвхөн өөрийн үүсгэснийг).
    match /meets/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.host == request.auth.uid;
      allow create: if mine(request.resource.data.host)
        && code.matches('^[a-z]{3}-[a-z]{4}-[a-z]{3}$')
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'title', 'live', 'names', 'status', 'audio', 'createdAt'])
        && request.resource.data.live == []
        && request.resource.data.names == {}
        && request.resource.data.status == 'active'
        && (!('audio' in request.resource.data) || request.resource.data.audio is bool)
        && isStr(request.resource.data.hostName, 40)
        && isStr(request.resource.data.title, 60)
        && stamped();
      // зөвхөн өөрийгөө live/names-д нэмж хасна; уулзалтыг зөвхөн эзэн нь хаана
      allow update: if signedIn()
        && changed().hasOnly(['live', 'names', 'status'])
        && request.resource.data.live is list
        && request.resource.data.live.toSet().difference(resource.data.live.toSet()).hasOnly([request.auth.uid])
        && resource.data.live.toSet().difference(request.resource.data.live.toSet()).hasOnly([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.names) || isStr(request.resource.data.names[request.auth.uid], 40))
        && (request.resource.data.status == resource.data.status
            || (request.resource.data.status == 'ended' && resource.data.host == request.auth.uid));
      allow delete: if mine(resource.data.host);

      match /sig/{sigId} {
        function mlive(u) { return u in get(/databases/$(database)/documents/meets/$(code)).data.live; }
        allow read, delete: if signedIn() && (resource.data.t == request.auth.uid || resource.data.f == request.auth.uid);
        allow create: if mine(request.resource.data.f)
          && request.resource.data.keys().hasOnly(['f', 't', 's', 'k', 'd'])
          && request.resource.data.t is string
          && request.resource.data.k in ['o', 'a', 'c', 'v']
          && isStr(request.resource.data.s, 20)
          && isStr(request.resource.data.d, 30000)
          && mlive(request.auth.uid) && mlive(request.resource.data.t);
      }
    }

    // Live: эзэн нь дамжуулж, нэвтэрсэн хэн ч үзнэ. v = одоо үзэж буй хүмүүс (хүн бүр зөвхөн өөрийгөө нэмж хасна),
    // hb = эзний 20 секунд тутмын "амьд" тэмдэг (апп нь гэнэт хаагдвал live жагсаалтаас алга болно)
    match /lives/{lid} {
      function ld() { return get(/databases/$(database)/documents/lives/$(lid)).data; }
      allow read: if signedIn();
      allow create: if mine(request.resource.data.host) && notBanned()
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'v', 'status', 'hb', 'createdAt'])
        && request.resource.data.v == []
        && request.resource.data.status == 'active'
        && isStr(request.resource.data.hostName, 40)
        && request.resource.data.hb == request.time
        && stamped();
      allow update: if signedIn() && (
        (resource.data.host == request.auth.uid
          && changed().hasOnly(['hb', 'status', 'k', 'v'])
          && (request.resource.data.status == resource.data.status || request.resource.data.status == 'ended')
          && (!('hb' in changed()) || request.resource.data.hb == request.time)
          // k = эзний гаргасан хүмүүс; эзэн v-ээс зөвхөн хасч чадна
          && (!('k' in changed()) || (request.resource.data.k is list && request.resource.data.k.size() <= 200))
          && (!('v' in changed()) || request.resource.data.v.toSet().difference(resource.data.v.toSet()).size() == 0))
        || (changed().hasOnly(['v'])
          && request.resource.data.v is list && request.resource.data.v.size() <= 500
          && request.resource.data.v.toSet().difference(resource.data.v.toSet()).hasOnly([request.auth.uid])
          && resource.data.v.toSet().difference(request.resource.data.v.toSet()).hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.v) || !(request.auth.uid in resource.data.get('k', [])))));
      allow delete: if mine(resource.data.host) || isAdmin();

      // WebRTC сигнал: зөвхөн эзэн ↔ үзэгчийн хооронд
      match /sig/{sigId} {
        allow read, delete: if signedIn() && (resource.data.t == request.auth.uid || resource.data.f == request.auth.uid);
        allow create: if mine(request.resource.data.f)
          && request.resource.data.keys().hasOnly(['f', 't', 's', 'k', 'd'])
          && request.resource.data.t is string
          && request.resource.data.k in ['o', 'a', 'c', 'x']
          && isStr(request.resource.data.s, 20)
          && isStr(request.resource.data.d, 30000)
          && ((request.resource.data.t == ld().host && !(request.auth.uid in ld().get('k', []))) || ld().host == request.auth.uid);
      }
      match /cm/{cid} {
        allow read: if signedIn();
        allow create: if mine(request.resource.data.uid) && notBanned()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && isStr(request.resource.data.name, 40)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
          && stamped()
          && ld().status == 'active' && !(request.auth.uid in ld().get('k', []));
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || ld().host == request.auth.uid || isAdmin());
      }
    }
  }
}
